{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://city.example/specs/profiles/mhm/1.0/card.json",
  "title": "MHM agent card",
  "allOf": [
    {
      "$ref": "../../../cap/1.0/card.json"
    },
    {
      "type": "object",
      "required": [
        "role",
        "capabilities",
        "no_clinical_advice"
      ],
      "properties": {
        "role": {
          "enum": [
            "booking_centre",
            "facility",
            "gp",
            "b2b"
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "districts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibility": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_clinical_advice": {
          "const": true
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "description": "Milan civic door stamped by Deploy (ADR-130). Teams do not author it.",
          "required": ["label", "lon", "lat"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "lon": {
              "type": "number"
            },
            "lat": {
              "type": "number"
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
